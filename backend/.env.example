# Database
DATABASE_URL=sqlite+aiosqlite:///./khetopedia.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/khetopedia
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
USE_REDIS=false

# Object Storage (S3-compatible)
S3_ENDPOINT_URL=
# Leave empty for AWS S3, set to http://localhost:9000 for MinIO
# Get credentials from: https://aws.amazon.com/console/ or your S3 provider
S3_ACCESS_KEY_ID=REPLACE_WITH_YOUR_AWS_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_AWS_SECRET_ACCESS_KEY
S3_BUCKET_NAME=khetopedia-images
S3_REGION=us-east-1
USE_S3=false

# Weather API
# Get free API key from: https://openweathermap.org/api
WEATHER_API_KEY=REPLACE_WITH_OPENWEATHERMAP_API_KEY
WEATHER_API_URL=https://api.openweathermap.org/data/2.5
WEATHER_CACHE_TTL=1800
USE_MOCK_WEATHER=true

# LLM Configuration
# Choose provider: "openai", "anthropic", "none"
LLM_PROVIDER=openai
# Get OpenAI key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Get Anthropic key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.7
USE_LLM=false

# Security
SECRET_KEY=khetopedia-super-secret-development-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=43200
OTP_EXPIRE_MINUTES=15

# CORS (comma-separated list)
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8000,http://localhost:8080,*
